    "import numpy as np\n",
    "from scipy.optimize import curve_fit\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from scipy.optimize import curve_fit\n",
    "from sklearn.metrics import r2_score\n",
    "import statsmodels.api as sm\n",
    "\n",
    "# Loading data\n",
    "data = np.loadtxt(\"data-23.txt\")\n",
    "t = data[:, 0]\n",
    "y = data[:, 1]\n",
    "\n",
    "# Model 1: Exponential model\n",
    "def model_1(t, alpha_0, alpha_1, alpha_2, beta_1, beta_2):\n",
    "    return alpha_0 + alpha_1 * np.exp(beta_1 * t) + alpha_2 * np.exp(beta_2 * t)\n",
    "\n",
    "# Initial guesses for Model 1 parameters\n",
    "initial_guess_model_1 = [1, 1, 1, -0.1, -0.1]  # Adjust as needed\n",
    "\n",
    "# Estimate parameters for Model 1\n",
    "popt1, pcov1 = curve_fit(model_1, t, y, p0=initial_guess_model_1, maxfev=5000)\n",
    "print(\"Model 1 parameters (alpha_0, alpha_1, alpha_2, beta_1, beta_2):\", popt1)\n",
    "\n",
    "# Model 2: Rational model\n",
    "def model_2(t, alpha_0, alpha_1, beta_0, beta_1):\n",
    "    return (alpha_0 + alpha_1 * t) / (beta_0 + beta_1 * t)\n",
    "\n",
    "# Initial guesses for Model 2 parameters\n",
    "initial_guess_model_2 = [1, 1, 1, 1]  # Adjust as needed\n",
    "\n",
    "# Estimate parameters for Model 2\n",
    "popt2, pcov2 = curve_fit(model_2, t, y, p0=initial_guess_model_2, maxfev=5000)\n",
    "print(\"Model 2 parameters (alpha_0, alpha_1, beta_0, beta_1):\", popt2)\n",
    "\n",
    "# Model 3: Polynomial model\n",
    "X = np.vstack([t**i for i in range(5)]).T  # Columns: [1, t, t^2, t^3, t^4]\n",
    "\n",
    "# Solve for the least squares\n",
    "beta, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)\n",
    "print(\"Model 3 parameters (beta_0, beta_1, beta_2, beta_3, beta_4):\", beta)\n",
    "\n",
    "# Plotting the results\n",
    "plt.figure(figsize=(12, 8))\n",
    "plt.scatter(t, y, label='Data', color='black')\n",
    "\n",
    "# Plot each model\n",
    "t_fit = np.linspace(min(t), max(t), 100)\n",
    "\n",
    "# Model 1 plot\n",
    "plt.plot(t_fit, model_1(t_fit, *popt1), label='Model 1 (Exponential)')\n",
