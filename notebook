    "import numpy as np\n",
    "from scipy.optimize import curve_fit, OptimizeWarning\n",
    "from sklearn.metrics import r2_score\n",
    "import warnings\n",
    "\n",
    "metrics = {}\n",
    "\n",
    "# AIC and BIC\n",
    "def calculate_aic_bic(y, y_pred, num_params):\n",
    "    rss = np.sum((y - y_pred)**2)\n",
    "    aic = len(y) * np.log(rss / len(y)) + 2 * num_params\n",
    "    bic = len(y) * np.log(rss / len(y)) + num_params * np.log(len(y))\n",
    "    return rss, aic, bic\n",
    "\n",
    "# Suppress warnings for failed covariance estimation\n",
    "with warnings.catch_warnings():\n",
    "    warnings.simplefilter(\"ignore\", category=OptimizeWarning)\n",
    "\n",
    "    # Model 1\n",
    "    try:\n",
    "        popt1, _ = curve_fit(model_1, t, y, p0=[1, 1, 1, -0.1, -0.1], maxfev=10000,\n",
    "                             bounds=([-np.inf, -np.inf, -np.inf, -1, -1], [np.inf, np.inf, np.inf, 0, 0]), method='trf')\n",
    "        y_pred1 = model_1(t, *popt1)\n",
    "        rss1, aic1, bic1 = calculate_aic_bic(y, y_pred1, len(popt1))\n",
    "        r2_1 = r2_score(y, y_pred1)\n",
    "        metrics['Model 1'] = {'RSS': rss1, 'R2': r2_1, 'AIC': aic1, 'BIC': bic1}\n",
    "    except RuntimeError as e:\n",
    "        print(\"Model 1 optimization failed:\", e)\n",
    "\n",
    "    # Model 2\n",
    "    try:\n",
    "        popt2, _ = curve_fit(model_2, t, y, p0=[1, 1, 1, 1], maxfev=5000,\n",
    "                             bounds=([-np.inf, -np.inf, -np.inf, -np.inf], [np.inf, np.inf, np.inf, np.inf]))\n",
    "        y_pred2 = model_2(t, *popt2)\n",
    "        rss2, aic2, bic2 = calculate_aic_bic(y, y_pred2, len(popt2))\n",
    "        r2_2 = r2_score(y, y_pred2)\n",
    "        metrics['Model 2'] = {'RSS': rss2, 'R2': r2_2, 'AIC': aic2, 'BIC': bic2}\n",
    "    except RuntimeError as e:\n",
    "        print(\"Model 2 optimization failed:\", e)\n",
    "\n",
    "    # Model 3\n",
    "    try:\n",
    "        X3 = np.column_stack([t**i for i in range(5)])  # Polynomial terms t^0, t^1, ..., t^4\n",
    "        beta_hat = np.linalg.lstsq(X3, y, rcond=None)[0]\n",
    "        y_pred3 = X3 @ beta_hat\n",
    "        rss3, aic3, bic3 = calculate_aic_bic(y, y_pred3, len(beta_hat))\n",
    "        r2_3 = r2_score(y, y_pred3)\n",
    "        metrics['Model 3'] = {'RSS': rss3, 'R2': r2_3, 'AIC': aic3, 'BIC': bic3}\n",
    "    except RuntimeError as e:\n",
    "        print(\"Model 3 optimization failed:\", e)\n",
    "\n",
    "# Print results in a table\n",
    "print(f\"{'Model':<10} {'RSS':<10} {'R2':<10} {'AIC':<10} {'BIC':<10}\")\n",
    "for model, values in metrics.items():\n",
    "    print(f\"{model:<10} {values['RSS']:<10.2f} {values['R2']:<10.4f} {values['AIC']:<10.2f} {values['BIC']:<10.2f}\")\n",
    "\n",
    "# Determine the best model\n",
    "best_model = min(metrics.keys(), key=lambda m: metrics[m]['AIC'])\n",
    "print(\"\\nBest model based on AIC:\", best_model)\n"
   ]
